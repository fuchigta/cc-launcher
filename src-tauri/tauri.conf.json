{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cc-launcher",
  "version": "0.17.16",
  "identifier": "com.cc-launcher.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Code Launcher",
        "width": 600,
        "height": 120,
        "visible": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "resizable": false
      },
      {
        "label": "settings",
        "title": "Settings - Claude Code Launcher",
        "width": 450,
        "height": 480,
        "visible": false,
        "center": true,
        "decorations": true,
        "resizable": false,
        "url": "index.html#/settings"
      },
      {
        "label": "manager",
        "title": "Manager - Claude Code Launcher",
        "width": 900,
        "height": 650,
        "visible": false,
        "center": true,
        "decorations": true,
        "resizable": true,
        "url": "index.html#/manager"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: tauri:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "windows": {
      "wix": {
        "language": "ja-JP",
        "fragmentPaths": [
          "wix/add-to-path.wxs",
          "wix/startup.wxs"
        ],
        "componentRefs": [
          "SystemPath",
          "StartupRegistration"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "plugins/bin/folder-watcher.exe": "plugins/folder-watcher.exe",
      "plugins/bin/imap-watcher.exe": "plugins/imap-watcher.exe"
    }
  }
}
