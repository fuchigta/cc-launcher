{
  "name": "cc-launcher",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bump": "node scripts/bump-version.mjs",
    "ts:lint": "oxlint src/",
    "ts:fmt": "oxfmt --write src/",
    "ts:fmt:check": "oxfmt src/",
    "ts:typecheck": "tsc --noEmit",
    "rs:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "rs:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rs:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "hook:post-edit": "node scripts/hook-post-edit.mjs",
    "hook:final": "pnpm ts:typecheck && pnpm ts:lint && pnpm ts:fmt:check && pnpm rs:lint && pnpm rs:fmt:check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lefthook": "^2.0.15",
    "oxfmt": "^0.26.0",
    "oxlint": "^1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
